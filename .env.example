# توکن ربات تلگرام - از @BotFather بگیر
TELEGRAM_BOT_TOKEN=

# API Key جمینی - از https://aistudio.google.com/apikey بگیر
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Personal Access Token گیت‌هاب (Settings > Developer settings > Fine-grained tokens، اسکوپ Contents: Read & write)
GITHUB_TOKEN=

# ریپوی پیش‌فرض به فرم owner/repo (اختیاری - با /repo هم قابل تغییره)
GITHUB_DEFAULT_REPO=

# آیدی عددی تلگرام خودت (با @userinfobot بگیرش) - فقط همین آیدی اجازه استفاده داره
ALLOWED_TELEGRAM_USER_ID=
